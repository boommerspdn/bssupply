Options -MultiViews
DirectoryIndex disabled
RewriteEngine On
RewriteBase /

# A trailing slash on a route payload is never a page or a valid payload URL.
RewriteRule ^(.*/)?index\.txt/$ /$1 [R=302,L]

# Browser visits to payload files should open the HTML page. Keep fetch requests
# untouched: Next.js needs index.txt for client navigation.
RewriteCond %{HTTP:Sec-Fetch-Dest} =document
RewriteRule ^(.*/)?index\.txt$ /$1 [R=302,L]

# Hardcoded assets and ACME challenges remain files. CMS pages always use Next.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(?:_next/static/|\.well-known/|.*\.(?:png|jpe?g|gif|webp|svg|ico|woff2?|css|js)$) - [L]

# The hosting front proxy may forward its legacy directory index path.
RewriteRule ^(.*/)?index\.html$ http://127.0.0.1:4103/$1 [P,L]

# PM2 standalone runtime; do not serve the old exported index.html files.
RewriteRule ^(.*)$ http://127.0.0.1:4103/$1 [P,L]
